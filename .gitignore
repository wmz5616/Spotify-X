# 依赖库 (体积最大的部分，永远不要上传)
node_modules/
# Next.js (前端) 的编译缓存和输出
.next/
out/
# NestJS (后端) 的编译输出
dist/
# 数据库文件 (通常不将数据库本身纳入版本控制)
dev.db
dev.db-shm
dev.db-wal
# 环境变量文件 (包含敏感信息，绝不能上传到公开仓库)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 各种日志和临时文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# 操作系统和编辑器自动生成的文件
.DS_Store
Thumbs.db
.vscode/

.txt
# 忽略上传的媒体文件和缓存
public/covers/
public/artist-images/
public/cache/
# 保留必要的占位图
!public/placeholder.jpg
!public/favicon.ico

# Personal Music API 的文件 (忽略 public 下的文件)
personal-music-api/public/

# AI Agent 自动生成的技能和配置文件
.agents/

# 忽略 .gitignore 配置文件本身
.gitignore